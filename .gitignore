
.idea/

# Ortam yapilandirmasi — gizli bilgiler. Sablonu .env.example'dadir.
.env

# Derlenmis sablon onbellegi
files/cache/

# Guncelleme yedegi — "php vnl.php update" birakir, geri donus icin durur
vnl.bak/

# Yayin arsivleri — "php vnl.php release" ciktisi, surum varligi olarak yuklenir
dist/

# Claude Code yerel ayarlari — izin listesi makineye ozeldir, depoya girmez
.claude/

# Uygulama gunlukleri — LogModule (LOG_PATH varsayilani)
files/logs/
