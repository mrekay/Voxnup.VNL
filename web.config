<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Imported Rule 1" stopProcessing="true">
          <match url="^(.*)$" ignoreCase="false" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.php/{R:1}" appendQueryString="true" />
        </rule>
        <rule name="Imported Rule 1-1" enabled="true" stopProcessing="true">
          <match url="^(.*)$" ignoreCase="false" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTPS}" pattern="off" ignoreCase="false" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}{URL}" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <!-- This will handle requests up to 700MB (CD700) -->
        <requestLimits maxAllowedContentLength="524288000" />
        <!-- Gizli dosya ve dizinler hicbir kosulda servis edilmez -->
        <hiddenSegments>
          <add segment=".env" />
          <add segment=".env.example" />
          <add segment=".git" />
          <add segment=".gitignore" />
          <add segment=".gitattributes" />
          <add segment=".idea" />
          <add segment=".htaccess" />
        </hiddenSegments>
        <!-- Sunucuda kalmasi gereken dosya turleri -->
        <fileExtensions allowUnlisted="true">
          <add fileExtension=".sql" allowed="false" />
          <add fileExtension=".log" allowed="false" />
          <add fileExtension=".lock" allowed="false" />
          <add fileExtension=".ini" allowed="false" />
          <add fileExtension=".sh" allowed="false" />
          <add fileExtension=".bak" allowed="false" />
          <add fileExtension=".yml" allowed="false" />
          <add fileExtension=".yaml" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <add name="Cross-Origin-Opener-Policy" value="allow-popups" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
