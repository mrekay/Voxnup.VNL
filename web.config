<?xml version="1.0" encoding="UTF-8"?>
<!--
  Voxnup Not Laravel (VNL) — IIS yapılandırması

  Kökteki .htaccess'in IIS karşılığıdır; ikisi aynı korumayı sağlamalıdır.
  Birini değiştirirseniz ötekini de değiştirin.

  4.0.0: Önceki sürüm yalnız ön denetleyiciyi tanımlıyordu. config/,
  vnl/ (assets/ dışı), files/cache, files/logs, languages/*.json, actions/,
  classes/ ... doğrudan indirilebiliyordu; HTTPS kuralı ise ön denetleyicinin
  stopProcessing'inden sonra geldiği için hiç çalışmıyordu.

  Gereken: IIS URL Rewrite modülü (2.x). Kurallar SIRAYLA işlenir; ilk
  eşleşen stopProcessing="true" kural zinciri bitirir. Engelleme kuralları bu
  yüzden ön denetleyiciden ÖNCE durur — aksi halde var olan dosya (IsFile)
  ön denetleyiciyi atlar ve düz metin olarak servis edilir.

  Eşleşme büyük/küçük harfe duyarsızdır (ignoreCase varsayılanı true ve
  aşağıda ayrıca yazıldı): NTFS duyarsızdır, /CONFIG/database.php aynı
  dosyayı açar. Desen, IIS'in çözdüğü (URL-decoded) yola, baştaki "/"
  olmadan uygulanır; %2e gibi kodlamalar desenin önüne geçemez.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- 1. Nokta ile başlayan her yol parçası: .env, .git, .github,
             .htaccess, .idea ... .well-known ACME/Let's Encrypt doğrulaması
             için açık kalır. Aşağıdaki hiddenSegments listesi ikinci hattır;
             bu kural adı listede olmayanları da (yeni bir .xyz) yakalar. -->
        <rule name="VNL: nokta ile başlayan yollar" stopProcessing="true">
          <match url="(^|/)\.(?!well-known)" ignoreCase="true" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
        </rule>

        <!-- 2. Nokta ya da boşlukla biten ara yol parçası (config./x,
             "languages /tr.json"). Windows dosya adındaki sondaki nokta ve
             boşluğu sessizce atar; bu yol aşağıdaki dizin desenlerini
             atlayıp aynı dosyayı açardı. Meşru bir adres böyle bitmez. -->
        <rule name="VNL: nokta/boşlukla biten yol parçası" stopProcessing="true">
          <match url="[. ]/" ignoreCase="true" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
        </rule>

        <!-- 3. HTTPS'e yönlendirme (isteğe bağlı, .htaccess'teki gibi kapalı).
             Açmak için enabled="true" yazın. Önceki sürümde bu kural ön
             denetleyiciden sonra geldiği için hiç çalışmıyordu; engelleme
             kurallarından sonra, ön denetleyiciden önce durmalı. -->
        <rule name="VNL: HTTPS yönlendirmesi" enabled="false" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTPS}" pattern="^off$" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" appendQueryString="true" redirectType="Permanent" />
        </rule>

        <!-- 4. Sunucuda duran ama web'den ASLA okunmaması gereken dizinler.
             Yalnız bu dizinlerin İÇİNDEKİ var olan dosya/dizinler engellenir;
             var olmayan bir alt yol (/jobs/123 gibi bir sayfa adresi) ön
             denetleyiciye düşer. .htaccess'teki -f/-d koşullarının aynısı. -->
        <rule name="VNL: proje dizinleri" stopProcessing="true">
          <match url="^(actions|classes|commands|config|controller|exceptions|extensions|files/cache|files/logs|helpers|jobs|languages|migrations|modules|validators|view)/." ignoreCase="true" />
          <conditions logicalGrouping="MatchAny">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" />
          </conditions>
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
        </rule>

        <!-- 5. Web'e hiç açılmayan dizinler (3.5.2): güncelleme yedeği (eski
             çekirdek sürümünün dosyaları), yayın arşivleri, geliştirme
             dosyaları. Koşulsuz: dizinin kendisi de alt yolları da 403. -->
        <rule name="VNL: yedek ve geliştirme dizinleri" stopProcessing="true">
          <match url="^(vnl\.bak|dist|tests|docker)(/|$)" ignoreCase="true" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
        </rule>

        <!-- 6. Yükleme dizinlerinde betik ÇALIŞMAZ (3.5.2). files/
             (FileManagerModule'ün varsayılan hedefi) ve yaygın yükleme
             dizinlerindeki betik uzantıları yorumlanmadan reddedilir;
             yüklemeden kaçan tek bir .php dosyası uzaktan kod çalıştırmaya
             dönüşmez. (\.|/|$): x.php.jpg ve x.php/yol da yakalanır. -->
        <rule name="VNL: yükleme dizinlerinde betik" stopProcessing="true">
          <match url="^(files|uploads?|media|storage)/.*\.(php\d*|phtml|pht|phar|phps|pgif|cgi|pl|py|shtml?)(\.|/|$)" ignoreCase="true" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
        </rule>

        <!-- 7. Dizinin kendi adı (/jobs, /config/) bir SAYFA adresidir ve
             ön denetleyiciye gider; 4. kural yalnız alt yolları engeller.
             IIS eğik çizgisiz dizine "/" ekleyen yönlendirmeyi işleyiciden
             sonra yapar, URL Rewrite ondan önce çalışır — /jobs doğrudan
             sayfayı açar. -->
        <rule name="VNL: dizin adındaki sayfalar" stopProcessing="true">
          <match url="^(actions|classes|commands|config|controller|exceptions|extensions|files/cache|files/logs|helpers|jobs|languages|migrations|modules|validators|view)/?$" ignoreCase="true" />
          <action type="Rewrite" url="index.php/{R:0}" appendQueryString="true" />
        </rule>

        <!-- 8. Çekirdek: vnl/ altından yalnız vnl/assets/ servis edilir.
             vnl/boot.php, vnl/VERSION, vnl/MANIFEST, vnl/vendor/... 403. -->
        <rule name="VNL: çekirdek dizini" stopProcessing="true">
          <match url="^vnl(/?$|/(?!assets/))" ignoreCase="true" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
        </rule>

        <!-- 9. Ön denetleyici: dosya olmayan her şey index.php'ye. Yönlendirme
             kernel.php'de REQUEST_URI ile yapılır; IIS FastCGI'da o değişken
             yeniden yazılmamış özgün adresi taşır. Dizinler de buraya düşer
             (kök "/" dahil): korunan dizinler yukarıda zaten yakalandı,
             kalanlar (assets/ gibi) dizin listesi yerine uygulamanın 404'ünü
             gösterir. -->
        <rule name="VNL: ön denetleyici" stopProcessing="true">
          <match url="^(.*)$" ignoreCase="true" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.php/{R:1}" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <!-- This will handle requests up to 700MB (CD700) -->
        <requestLimits maxAllowedContentLength="524288000" />
        <!-- Gizli dosya ve dizinler hiçbir koşulda servis edilmez. URL Rewrite
             kurulu değilse ya da kurallar kapatılırsa ikinci savunma hattı. -->
        <hiddenSegments>
          <add segment=".env" />
          <add segment=".env.example" />
          <add segment=".git" />
          <add segment=".github" />
          <add segment=".gitignore" />
          <add segment=".gitattributes" />
          <add segment=".gitleaksignore" />
          <add segment=".idea" />
          <add segment=".htaccess" />
          <add segment="composer.json" />
          <!-- Konsol giriş noktası: CLI dışında zaten çalışmayı reddeder,
               ama web'den hiç görünmemesi doğru olan -->
          <add segment="vnl.php" />
          <add segment="vnl.cmd" />
          <!-- 4.0.0: güncelleme yedeği. config, jobs gibi dizinler buraya
               yazılamaz: hiddenSegments yolun HER parçasına bakar ve /config
               sayfa adresini de kapatırdı; onlar URL Rewrite kurallarında. -->
          <add segment="vnl.bak" />
        </hiddenSegments>
        <!-- 4.0.0: 8.3 kısa adları (CONTRO~1, LANGUA~1). Windows uzun adı
             bilinmeden dizine kısa adıyla erişilebilir ve kısa ad yukarıdaki
             desenlere uymaz. Uygulama adreslerinde "~" geçmez. -->
        <denyUrlSequences>
          <add sequence="~" />
        </denyUrlSequences>
        <!-- Sunucuda kalması gereken dosya türleri (.htaccess'teki FilesMatch) -->
        <fileExtensions allowUnlisted="true">
          <add fileExtension=".sql" allowed="false" />
          <add fileExtension=".log" allowed="false" />
          <add fileExtension=".lock" allowed="false" />
          <add fileExtension=".ini" allowed="false" />
          <add fileExtension=".sh" allowed="false" />
          <add fileExtension=".bak" allowed="false" />
          <add fileExtension=".yml" allowed="false" />
          <add fileExtension=".yaml" allowed="false" />
          <add fileExtension=".md" allowed="false" />
          <add fileExtension=".dist" allowed="false" />
          <add fileExtension=".example" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <add name="Cross-Origin-Opener-Policy" value="allow-popups" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
