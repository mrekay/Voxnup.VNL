# ============================================================
#  Voxnup Not Laravel (VNL) — Ortam Yapılandırması
#  Bu dosyayı .env olarak kopyalayın ve kendi değerlerinizi girin.
#  .env asla commit edilmez, web sunucusu tarafından da servis edilmez.
# ============================================================

# ---- Uygulama ----
# Geliştirme kipi. true iken hata sayfası kaynak kod, yol ve yığın izi
# gösterir, PHP uyarıları ekrana basılır. CANLIDA DAİMA false: kullanıcı
# yalnız başvuru kodlu genel bir hata görür, ayrıntı sunucu günlüğüne gider.
APP_DEBUG=false

# PHP saat dilimi. MySQL oturumunun saat dilimi ayrıdır ve değiştirilmez;
# NOW() ile date() farklı dilimde olabilir.
APP_TIMEZONE=Europe/Istanbul

APP_URL=ornek.com
APP_MASTER_URL=ornek.com
APP_ASSETS_URL=/assets
APP_COOKIE_PREFIX=vnl

# VNL'in kendi varlıkları (tema, vnl.js, vnltable). PROJENİN varlıkları
# APP_ASSETS_URL'dedir; bu ondan ayrıdır çünkü sahibi çekirdektir ve
# güncellemede komple değişir. Yalnız CDN'e taşırken değiştirin.
VNL_ASSETS_URL=/vnl/assets
APP_PRODUCT_ID=0

# Kullanılmıyor (geriye uyumluluk için duruyor). Çerezler bununla
# imzalanmaz; "beni hatırla" jetonu rastgele üretilir ve özeti saklanır.
APP_SALT=

# EncryptionModule::safeEncrypt/safeDecrypt anahtarı — base64 kodlanmış 32 bayt.
# Üretmek için:  php -r "echo base64_encode(random_bytes(32));"
# Değiştirmek daha önce şifrelenmiş her veriyi çözülemez hale getirir.
APP_ENCRYPTION_KEY=

# ---- Mail (SMTP) ----
# MAIL_HOST boşsa MailModule::SendMail() gönderim yapmaz, hatayı loglar.
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl              # ssl | tls | none
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
# Kendi imzalı sertifikalı SMTP sunucusu için false yapın; aksi halde
# sertifika doğrulaması açık kalmalıdır.
MAIL_VERIFY_PEER=true

# ---- Veritabanı ----
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
# Unix soketi verilirse DB_HOST/DB_PORT yerine o kullanılır:
#   DB_SOCKET=/run/mysqld/mysqld.sock
DB_SOCKET=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PREFIX=
DB_MASTER=

# ---- Oturum ve güvenlik (3.4.0) ----
# Boşta kalma sınırı (sn). Bu süre istek gelmezse oturum kapanır; 0 kapatır.
VNL_SESSION_IDLE=3600
# "Beni hatırla" süresi (gün). 0 özelliği tamamen kapatır.
VNL_REMEMBER_DAYS=30
# Oturum çerezinin SameSite değeri: Lax (varsayılan) | Strict | None.
# None yalnız HTTPS'te geçerlidir; siteler arası isteklere çerez gönderir.
VNL_SESSION_SAMESITE=Lax
# X-Frame-Options, nosniff, Referrer-Policy, Permissions-Policy, HSTS (TLS'te).
VNL_SECURITY_HEADERS=true
# Doküman sayfaları (/docs/*) girişsiz açılsın mı?
VNL_PUBLIC_DOCS=false
# Geçiş kipi: 3.3'ün "$page_config['public']" davranışı. Korumalı denetleyici
# girişsiz istekte ÇALIŞTIRILIR; yan etkili denetleyicide güvenli değildir.
VNL_PUBLIC_CAPTURE=false

# ---- Günlük ----
# LogModule dizini (göreli yol proje köküne göredir). Varsayılan files/logs.
LOG_PATH=

# Not: içinde boşluk veya # geçen değerleri tırnak içine alın.
#   DB_PASSWORD="p#ss w0rd"
