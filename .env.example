# ============================================================
#  Voxnup Not Laravel (VNL) 3.0.0 — Ortam Yapılandırması
#  Bu dosyayı .env olarak kopyalayın ve kendi değerlerinizi girin.
#  .env asla commit edilmez, web sunucusu tarafından da servis edilmez.
# ============================================================

# ---- Uygulama ----
APP_URL=ornek.com
APP_MASTER_URL=ornek.com
APP_ASSETS_URL=/assets
APP_COOKIE_PREFIX=vnl
APP_PRODUCT_ID=0

# Oturum çerezlerinin imzalanmasında kullanılır.
# Rastgele ve gizli olmalıdır; her kurulumda farklı bir değer üretin.
# Değiştirmek mevcut "beni hatırla" çerezlerini geçersiz kılar.
APP_SALT=

# ---- Veritabanı ----
DB_DRIVER=mysql
DB_HOST=localhost
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8
DB_COLLATION=utf8_unicode_ci
DB_PREFIX=
DB_MASTER=

# Not: içinde boşluk veya # geçen değerleri tırnak içine alın.
#   DB_PASSWORD="p#ss w0rd"
