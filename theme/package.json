{
  "name": "vnl-theme",
  "version": "1.0.0",
  "private": true,
  "description": "VNL Theme — Bootstrap 5.3 tabanlı VNL arayüz teması (kaynak). Derlenmiş çıktı assets/vnl/ altına commit edilir.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:css && npm run build:js && npm run build:assets",
    "build:css": "sass --style=compressed --no-source-map --quiet-deps --silence-deprecation=import,global-builtin,color-functions,if-function scss/vnl.scss:../assets/vnl/css/vnl.min.css scss/fa.scss:../assets/vnl/css/fa.min.css",
    "build:js": "node build.mjs js",
    "build:assets": "node build.mjs assets",
    "watch:css": "sass --watch --style=expanded --embed-source-map --quiet-deps --silence-deprecation=import,global-builtin,color-functions,if-function scss/vnl.scss:../assets/vnl/css/vnl.min.css",
    "watch:js": "node build.mjs js --watch"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "sass": "^1.93.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fortawesome/fontawesome-free": "7.3.0",
    "bootstrap": "5.3.8",
    "jquery": "3.7.1",
    "slim-select": "3.4.3",
    "sweetalert2": "~11.26.0"
  }
}
